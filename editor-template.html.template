<!doctype html>
<html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Karakter Yerleşim Editörü</title><style>
*{box-sizing:border-box}body{margin:0;background:#101722;color:#e7eef8;font:14px system-ui,sans-serif}header{padding:20px 26px;border-bottom:1px solid #344155;display:flex;gap:20px;align-items:center;justify-content:space-between}h1{font-size:23px;margin:0}p{color:#a7b7cb;line-height:1.6;margin:8px 0}.layout{display:grid;grid-template-columns:230px minmax(320px,1fr) 270px;gap:16px;padding:18px;max-width:1500px;margin:auto}aside{background:#1a2433;padding:16px;border-radius:16px}button,select,input{font:inherit;color:inherit;background:#26364b;border:1px solid #44556f;border-radius:8px;padding:9px;min-width:0}button{cursor:pointer}button:hover{background:#354a65}button.active{background:#376653;border-color:#a2ebc6}.primary{background:#a2ebc6;color:#142c21;font-weight:700}.stage{background:radial-gradient(ellipse,#374c66,#1b293d);border:1px solid #3b4e68;border-radius:18px;position:relative;overflow:hidden}.stage svg{display:block;width:100%;height:min(78vh,820px);min-height:480px;touch-action:none}.part{cursor:grab}.part:active{cursor:grabbing}.tools{display:flex;flex-wrap:wrap;gap:6px;margin:12px 0}.tools button{flex:1}.list{max-height:65vh;overflow:auto;display:grid;gap:5px}.list button{text-align:left;font-size:12px;padding:8px}.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}label{display:block;color:#becbdb;font-size:12px;margin:12px 0 5px}input[type=number],select{width:100%}input[type=range]{width:100%;padding:0}h2{font-size:15px;margin:5px 0 12px}.muted{font-size:12px;color:#9eafc5}#status{min-height:40px;margin:12px 0;font-size:12px;color:#a2ebc6}#asset{overflow-wrap:anywhere;font-size:11px;color:#9eafc5}a{color:#a2ebc6}summary{cursor:pointer}.full{width:100%;margin-top:8px}@media(max-width:950px){.layout{grid-template-columns:170px 1fr}.settings{grid-column:1/-1}.list{max-height:540px}header{display:block}}@media(max-width:580px){.layout{grid-template-columns:1fr}.layers{order:2}.settings{order:3}.stage svg{min-height:450px}.list{max-height:240px}}
</style></head><body><header><div><h1>Karakter Yerleşim Editörü</h1><p>Parçayı seç, sürükle, döndür. Hazır olduğunda yerleşimi dışa aktar.</p></div><a href="karakter-uretici.html">Karakter üreticisine dön ↗</a></header><main class="layout"><aside class="layers"><h2>Parçalar</h2><p class="muted">Önden arkaya sıralı. Shift + tıklama ile çoklu seçim.</p><div class="tools"><button id="leftArm">Sol kol grubu</button><button id="rightArm">Sağ kol grubu</button></div><div id="layers" class="list"></div></aside><section class="stage"><svg id="stage" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 720" aria-label="Düzenlenebilir karakter"><defs><pattern id="gridPattern" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M 20 0 L 0 0 0 20" fill="none" stroke="#b5cbe0" stroke-opacity=".12"/></pattern></defs><rect id="grid" width="600" height="720" fill="url(#gridPattern)"/><path id="guide" d="M300 0V720 M0 650H600" stroke="#a2ebc6" stroke-opacity=".3" stroke-dasharray="5 6" pointer-events="none"/><defs id="hairFilters"></defs><g id="pieces"></g><g id="outlines" pointer-events="none"></g></svg></section><aside class="settings"><a class="primary full" style="display:block;text-align:center;text-decoration:none;padding:12px;border-radius:8px" href="uc-parca-editoru.html">Üç parça birleştirme modu ↗</a><a href="deneme-modu.html" class="primary full" style="display:block;padding:12px;border-radius:8px;text-align:center;text-decoration:none">▶ Deneme modu · Voleybol</a><h2>Karakter seçenekleri</h2><p class="muted">Başlangıç pozu senin gönderdiğin yerleşimdir.</p><button id="newCharacter" class="primary full">✦ Yeni karakter oluştur</button><button id="randomFace" class="full">Yüz karakteristiğini değiştir</button><label for="faceAmount">Yüz çeşitliliği</label><input id="faceAmount" type="range" min="0" max="100" value="55"><label for="hairColor">Saç rengi</label><select id="hairColor"></select><label for="shirtColor">Üst kıyafet rengi</label><select id="shirtColor"></select><label for="pantsColor">Pantolon rengi</label><select id="pantsColor"></select><label for="shoeColor">Ayakkabı rengi</label><select id="shoeColor"></select><button id="randomClothes" class="full">Kıyafet renklerini karıştır</button><hr style="border:0;border-top:1px solid #44556f;margin:22px 0"><h2 id="selectionTitle">Parça seç</h2><div class="row"><div><label for="x">X konumu</label><input id="x" type="number" step="1"></div><div><label for="y">Y konumu</label><input id="y" type="number" step="1"></div></div><label for="angle">Dönüş açısı (derece)</label><input id="angle" type="number" step="1"><div class="tools"><button data-turn="-5">↶ 5°</button><button data-turn="5">↷ 5°</button></div><label for="scale">Boyut (%)</label><input id="scale" type="number" min="10" max="400" step="1"><p class="muted">Döndürme merkezi turuncu noktadır. Çoklu seçimde ilk parçanın merkezi kullanılır.</p><div class="tools"><button id="flip">Aynala</button><button id="front">Öne al</button><button id="back">Arkaya al</button></div><div id="asset"></div><div class="tools"><button id="undo">Geri al</button><button id="redo">Yinele</button></div><label><input type="checkbox" id="showGrid" checked> Izgara ve kılavuzlar</label><button id="export" class="primary full">↓ Yerleşimi dışa aktar (JSON)</button><button id="snapshot" class="full">↓ Görünümü indir (SVG)</button><button id="import" class="full">Yerleşim JSON aç</button><input id="file" type="file" accept=".json,application/json" hidden><button id="reset" class="full">Gönderdiğim yerleşime dön</button><div id="status" role="status" aria-live="polite">Hazır karakter ortada. Düzenleme için bu dosyayı Chrome veya Edge ile aç.</div><details><summary>Kullanım</summary><p class="muted">Seçili parçayı ok tuşlarıyla 1 piksel, Shift + ok ile 10 piksel taşı. Kol grubu düğmeleri ten kolunu, kıyafet kolunu ve eli birlikte seçer. Grubu döndürdüğünde el de omuz etrafında hareket eder.</p><p class="muted">JSON dosyası tüm parça konumlarını, dönüşlerini, boyutlarını ve katman sırasını taşır. Bu dosyayı sohbete ekle; diğer karakterleri aynı yerleşime uyarlayabiliriz. İstersen SVG görünümünü de ekleyebilirsin.</p><p class="muted">Düzenlemeler bu tarayıcıda otomatik saklanır. Kalıcı kopya için JSON indir.</p></details></aside></main><script>
'use strict';
const assets=__ASSETS__;
const NS='http://www.w3.org/2000/svg', $=id=>document.getElementById(id), stage=$('stage');
const dimensions={};for(const [path,data] of Object.entries(assets)){const b=atob(data.split(',')[1]);const n=i=>((b.charCodeAt(i)*16777216)+(b.charCodeAt(i+1)<<16)+(b.charCodeAt(i+2)<<8)+b.charCodeAt(i+3));dimensions[path]={width:n(16),height:n(20)}}
let parts=[],selected=[],history=[],future=[],drag=null;
function part(id,label,path,x,y,flip=false,pivotX=.5,pivotY=.5){return{id,label,path,x,y,rotation:0,scale:1,flip,pivotX,pivotY,...dimensions[path]}}
const approvedLayout=__LAYOUT__;
function initial(){return JSON.parse(JSON.stringify(approvedLayout))}
const clone=v=>JSON.parse(JSON.stringify(v));const chosen=()=>selected.map(id=>parts.find(p=>p.id===id)).filter(Boolean);
const pivot=p=>({x:p.x+p.width*p.scale*p.pivotX,y:p.y+p.height*p.scale*p.pivotY});
function rotate(list,degrees){if(!list.length)return;const c=pivot(list[0]),a=degrees*Math.PI/180;for(const p of list){const q=pivot(p),dx=q.x-c.x,dy=q.y-c.y;p.x+=c.x+dx*Math.cos(a)-dy*Math.sin(a)-q.x;p.y+=c.y+dx*Math.sin(a)+dy*Math.cos(a)-q.y;p.rotation+=degrees}}
function fresh(){parts=initial()}
function record(){history.push(clone(parts));if(history.length>100)history.shift();future=[]}
function persist(){try{localStorage.setItem('kenney-layout-editor-approved-v4-colors',JSON.stringify(parts))}catch{}}
function transform(p){const q=pivot(p);return `translate(${q.x} ${q.y}) rotate(${p.rotation}) scale(${p.scale}) translate(${-p.width*p.pivotX} ${-p.height*p.pivotY})`}
function el(tag,attrs={}){const n=document.createElementNS(NS,tag);for(const[k,v]of Object.entries(attrs))n.setAttribute(k,v);return n}
function render(){renderHairFilters();const holder=$('pieces'),overlay=$('outlines');holder.replaceChildren();overlay.replaceChildren();for(const p of parts){const g=el('g',{transform:transform(p),'data-id':p.id,class:'part'});const im=el('image',{href:assets[p.path],width:p.width,height:p.height});if(p.tint)im.setAttribute('filter','url(#tint-'+p.id+')');if(p.flip)im.setAttribute('transform',`translate(${p.width} 0) scale(-1 1)`);g.append(im);holder.append(g);if(selected.includes(p.id)){const box=el('g',{transform:transform(p)});box.append(el('rect',{width:p.width,height:p.height,fill:'none',stroke:'#a2ebc6','stroke-width':1.5/p.scale,'stroke-dasharray':'4 3'}));overlay.append(box)}}const picked=chosen();if(picked.length){const q=pivot(picked[0]);overlay.append(el('circle',{cx:q.x,cy:q.y,r:5,fill:'#ffc47d',stroke:'#182536'}))}
$('layers').replaceChildren(...[...parts].reverse().map(p=>{const b=document.createElement('button');b.textContent=p.label;b.classList.toggle('active',selected.includes(p.id));b.onclick=e=>{select(p.id,e.shiftKey);render()};return b}));sync();persist()}
function select(id,add){if(add){selected=selected.includes(id)?selected.filter(x=>x!==id):[...selected,id]}else selected=[id]}
function sync(){syncColors();const list=chosen(),p=list[0];$('selectionTitle').textContent=p?(list.length>1?list.length+' parça seçili':p.label):'Parça seç';for(const id of ['x','y','angle','scale','flip','front','back'])$(id).disabled=!p;for(const[id,value]of Object.entries({x:p?.x,y:p?.y,angle:p?.rotation,scale:p?p.scale*100:undefined}))$(id).value=value===undefined?'':Math.round(value*100)/100;$('asset').textContent=p?.path??'';$('undo').disabled=!history.length;$('redo').disabled=!future.length}
function point(e){return new DOMPoint(e.clientX,e.clientY).matrixTransform(stage.getScreenCTM().inverse())}
stage.addEventListener('pointerdown',e=>{const g=e.target.closest('[data-id]');if(!g){selected=[];render();return}const id=g.dataset.id;if(e.shiftKey){select(id,true);render();return}if(!selected.includes(id))select(id,false);record();drag={start:point(e),before:clone(parts),ids:[...selected],pointer:e.pointerId};stage.setPointerCapture(e.pointerId);render();e.preventDefault()});
stage.addEventListener('pointermove',e=>{if(!drag)return;const q=point(e),dx=q.x-drag.start.x,dy=q.y-drag.start.y;for(const p of parts)if(drag.ids.includes(p.id)){const old=drag.before.find(x=>x.id===p.id);p.x=old.x+dx;p.y=old.y+dy}render()});
function endDrag(){drag=null}stage.addEventListener('pointerup',endDrag);stage.addEventListener('pointercancel',endDrag);stage.addEventListener('lostpointercapture',endDrag);
for(const axis of ['x','y'])$(axis).onchange=()=>{const a=chosen(),value=Number($(axis).value);if(!a.length||!Number.isFinite(value))return;record();const delta=value-a[0][axis];a.forEach(p=>p[axis]+=delta);render()};
$('angle').onchange=()=>{const a=chosen(),value=Number($('angle').value);if(!a.length||!Number.isFinite(value))return;record();rotate(a,value-a[0].rotation);render()};
document.querySelectorAll('[data-turn]').forEach(b=>b.onclick=()=>{if(!chosen().length)return;record();rotate(chosen(),Number(b.dataset.turn));render()});
$('scale').onchange=()=>{const a=chosen(),v=Number($('scale').value);if(!a.length||!Number.isFinite(v)||v<10||v>400){sync();return}record();const ratio=v/100/a[0].scale,c=pivot(a[0]);for(const p of a){const q=pivot(p);p.scale*=ratio;p.x=c.x+(q.x-c.x)*ratio-p.width*p.scale*p.pivotX;p.y=c.y+(q.y-c.y)*ratio-p.height*p.scale*p.pivotY}render()};
$('flip').onclick=()=>{record();chosen().forEach(p=>p.flip=!p.flip);render()};
for(const [id,toFront]of [['front',true],['back',false]])$(id).onclick=()=>{record();const a=parts.filter(p=>selected.includes(p.id)),b=parts.filter(p=>!selected.includes(p.id));parts=toFront?[...b,...a]:[...a,...b];render()};
for(const side of ['left','right'])$(side+'Arm').onclick=()=>{selected=['arm-'+side,'sleeve-'+side,'hand-'+side];render()};
$('undo').onclick=()=>{if(history.length){future.push(clone(parts));parts=history.pop();render()}};$('redo').onclick=()=>{if(future.length){history.push(clone(parts));parts=future.pop();render()}};
document.addEventListener('keydown',e=>{if(/INPUT|SELECT|TEXTAREA/.test(e.target.tagName))return;if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='z'){e.preventDefault();$(e.shiftKey?'redo':'undo').click();return}const d={ArrowLeft:[-1,0],ArrowRight:[1,0],ArrowUp:[0,-1],ArrowDown:[0,1]}[e.key];if(d&&chosen().length){e.preventDefault();record();chosen().forEach(p=>{p.x+=d[0]*(e.shiftKey?10:1);p.y+=d[1]*(e.shiftKey?10:1)});render()}});
$('showGrid').onchange=()=>{for(const id of ['grid','guide'])$(id).style.display=$('showGrid').checked?'':'none'};
function download(text,name,type){const url=URL.createObjectURL(new Blob([text],{type})),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}
$('export').onclick=()=>{const payload={format:'kenney-character-layout',version:1,canvas:{width:600,height:720},coordinates:'x/y are unrotated top-left; pivotX/Y normalized in unmirrored bounds; transform: translate(worldPivot) rotate(degrees) scale(scale) translate(-localPivot); flip applies to image only',variantAlignment:'Preserve each role world pivot when replacing assets; use new natural dimensions and same normalized pivot. Array order is back to front.',parts};download(JSON.stringify(payload,null,2),'karakter-yerlesimi.json','application/json');$('status').textContent='JSON indirildi. Bu dosyayı sohbete ekleyebilirsin.'};
$('snapshot').onclick=()=>{const out=el('svg',{xmlns:NS,viewBox:'0 0 600 720',width:600,height:720});out.append($('hairFilters').cloneNode(true));out.append($('pieces').cloneNode(true));download(new XMLSerializer().serializeToString(out),'karakter-yerlesimi.svg','image/svg+xml');$('status').textContent='Görünüm SVG olarak indirildi.'};
function validate(a){if(!Array.isArray(a)||a.length!==initial().length)throw Error('Parça sayısı uyuşmuyor.');const ids=new Set(initial().map(p=>p.id));for(const p of a){if(!ids.delete(p.id)||!assets[p.path]||typeof p.label!=='string'||typeof p.flip!=='boolean')throw Error('Geçersiz parça.');for(const k of ['x','y','rotation','scale','pivotX','pivotY','width','height'])if(typeof p[k]!=='number'||!Number.isFinite(p[k]))throw Error('Geçersiz koordinat.');if(p.tint!==undefined&&!/^#[0-9a-f]{6}$/i.test(p.tint))throw Error('Geçersiz saç rengi.');if(p.scale<.1||p.scale>4||p.pivotX<0||p.pivotX>1||p.pivotY<0||p.pivotY>1||p.width!==dimensions[p.path].width||p.height!==dimensions[p.path].height)throw Error('Geçersiz boyut.')}return a}
$('import').onclick=()=>$('file').click();$('file').onchange=async()=>{const f=$('file').files[0];if(!f)return;try{const data=JSON.parse(await f.text());if(data.format!=='kenney-character-layout'||data.version!==1)throw Error('Bu editörün JSON dosyasını seç.');const next=validate(data.parts);record();parts=next;selected=[];render();$('status').textContent='Yerleşim yüklendi.'}catch(e){$('status').textContent='Açılamadı: '+e.message}$('file').value=''};
$('reset').onclick=()=>{record();fresh();selected=[];render();$('status').textContent='Başlangıç pozuna dönüldü. Geri al ile düzenlemelerini geri getirebilirsin.'};
const hairPalette=[
{label:'Siyah',value:'Black'},{label:'Sarı',value:'Blonde'},{label:'Kahverengi 1',value:'Brown 1'},{label:'Kahverengi 2',value:'Brown 2'},{label:'Gri',value:'Grey'},{label:'Kızıl',value:'Red'},{label:'Kumral',value:'Tan'},{label:'Beyaz',value:'White'},
{label:'Gece mavisi',value:'#243b65'},{label:'Okyanus mavisi',value:'#397dcc'},{label:'Turkuaz',value:'#299d9d'},{label:'Zümrüt',value:'#317657'},{label:'Adaçayı',value:'#91ab83'},{label:'Mor',value:'#7540ad'},{label:'Lavanta',value:'#b29add'},{label:'Pembe',value:'#df83ad'},{label:'Fuşya',value:'#bc347b'},{label:'Bordo',value:'#792f49'},{label:'Bakır',value:'#b86738'},{label:'Bal sarısı',value:'#d6ad5e'},{label:'Küllü kumral',value:'#938478'},{label:'Platin',value:'#e1dbcb'},{label:'Gece siyahı',value:'#252431'},{label:'Gümüş mavi',value:'#a3b8cc'}];
function renderHairFilters(){const defs=$('hairFilters');defs.replaceChildren();for(const p of parts.filter(p=>p.tint)){const filter=el('filter',{id:'tint-'+p.id,'color-interpolation-filters':'sRGB',x:'-10%',y:'-10%',width:'120%',height:'120%'});const transfer=el('feComponentTransfer');for(const[channel,index]of [['R',1],['G',3],['B',5]])transfer.append(el('feFunc'+channel,{type:'linear',slope:parseInt(p.tint.slice(index,index+2),16)/160,intercept:0}));transfer.append(el('feFuncA',{type:'identity'}));filter.append(transfer);defs.append(filter)}}
function applyHairColor(value){const hair=byId('hair'),style=hair.path.match(/(Man|Woman)\d+\.png$/)[0],tinted=value.startsWith('#'),group=tinted?'Grey':value;
 const target=paths.find(p=>p.startsWith('PNG/Hair/'+group+'/')&&p.endsWith(style));const x=hair.x+hair.width*hair.scale/2,y=hair.y;replaceAsset(hair,target);hair.x=x-hair.width*hair.scale/2;hair.y=y;
 if(tinted)hair.tint=value;else delete hair.tint;
 const prefix=target.split('/').pop().replace(/(?:Man|Woman)\d+\.png$/,'');
 for(const p of parts.filter(p=>p.id.startsWith('brow-'))){const number=p.path.match(/Brow(\d)/)[1];replaceAsset(p,paths.find(path=>path.startsWith('PNG/Face/Eyebrows/'+prefix+'Brow'+number+'.png')));if(tinted)p.tint=value;else delete p.tint}
}
function setupHairColors(){$('hairColor').replaceChildren(...hairPalette.map(p=>{const option=document.createElement('option');option.value=p.value;option.textContent=p.label;return option}));$('hairColor').onchange=()=>{record();applyHairColor($('hairColor').value);render();$('status').textContent='Saç ve kaş rengi güncellendi.'}}

const paths=Object.keys(assets),pick=a=>a[Math.floor(Math.random()*a.length)],jitter=n=>(Math.random()*2-1)*n;
const colors={Blue:'Mavi',Green:'Yeşil',Grey:'Gri',Navy:'Lacivert',Pine:'Koyu yeşil',Red:'Kırmızı',White:'Beyaz',Yellow:'Sarı',Brown:'Kahverengi',Tan:'Bej',Black:'Siyah','Brown 1':'Kahverengi 1','Brown 2':'Kahverengi 2','Blue 1':'Mavi 1','Blue 2':'Mavi 2','Light Blue':'Açık mavi'};
const categoryGroups=c=>[...new Set(paths.filter(p=>p.startsWith('PNG/'+c+'/')).map(p=>p.split('/')[2]))];
const byId=id=>parts.find(p=>p.id===id);
const controls=[['shirtColor','Shirts','shirt'],['pantsColor','Pants','waist'],['shoeColor','Shoes','shoe-left']];
function syncColors(){const hair=byId('hair');$('hairColor').value=hair?.tint||hair?.path.split('/')[2]||'';for(const [control,category,role]of controls){const p=byId(role);if(p)$(control).value=p.path.split('/')[2]}}
// Keep the world pivot stable when replacing files with different natural dimensions.
function replaceAsset(p,path){if(!path||!dimensions[path])throw Error('Parça bulunamadı');const q=pivot(p);p.path=path;Object.assign(p,dimensions[path]);p.x=q.x-p.width*p.scale*p.pivotX;p.y=q.y-p.height*p.scale*p.pivotY}
function recolor(category,color){const candidates=paths.filter(p=>p.startsWith('PNG/'+category+'/'+color+'/'));for(const p of parts.filter(p=>p.path.startsWith('PNG/'+category+'/'))){const name=p.path.split('/').pop();const length=name.match(/_(long|short|shorter)\.png$/)?.[1];let target;if(length)target=candidates.find(p=>p.endsWith('_'+length+'.png'));else{const style=name.match(/(\d)\.png$/)?.[1];target=candidates.find(p=>!p.split('/').pop().includes('_')&&p.endsWith(style+'.png'))}replaceAsset(p,target)}}
for(const [control,category]of controls){$(control).replaceChildren(...categoryGroups(category).map(c=>{const option=document.createElement('option');option.value=c;option.textContent=colors[c]||c;return option}));$(control).onchange=()=>{record();recolor(category,$(control).value);render();$('status').textContent='Renk değişti; yerleşim korundu.'}}
function varyClothes(){for(const [,category]of controls)recolor(category,pick(categoryGroups(category)))}
function varyFace(){
 const amount=Number($('faceAmount').value)/100,head=byId('head'),originalHead=approvedLayout.find(p=>p.id==='head');
 const skin=head.path.split('/')[2],hairPrefix=byId('hair').path.split('/').pop().replace(/(?:Man|Woman)\d+\.png$/,'');
 const eyebrow=pick(paths.filter(p=>p.startsWith('PNG/Face/Eyebrows/'+hairPrefix+'Brow'))),eye=pick(paths.filter(p=>p.startsWith('PNG/Face/Eyes/'))),nose=pick(paths.filter(p=>p.startsWith('PNG/Face/Nose/'+skin+'/'))),mouth=pick(paths.filter(p=>p.startsWith('PNG/Face/Mouth/')));
 const eyeSpread=jitter(5)*amount,eyeHeight=jitter(3)*amount,browHeight=jitter(5)*amount,browAngle=jitter(12)*amount,noseX=jitter(3)*amount,noseY=jitter(3)*amount;
 const eyeScale=1+jitter(.13)*amount,noseScale=1+jitter(.15)*amount;
 for(const p of parts.filter(p=>/^(eye-|brow-|nose$|mouth$)/.test(p.id))){
   const base=approvedLayout.find(b=>b.id===p.id),ref=pivot(base),hc=pivot(head),originalCenter=pivot(originalHead),ratio=head.scale/originalHead.scale,a=(head.rotation-originalHead.rotation)*Math.PI/180;
   const dx=(ref.x-originalCenter.x)*ratio,dy=(ref.y-originalCenter.y)*ratio;
   const path=p.id.startsWith('eye-')?eye:p.id.startsWith('brow-')?eyebrow:p.id==='nose'?nose:mouth;
   if(p.id.startsWith('brow-')&&byId('hair').tint)p.tint=byId('hair').tint;else delete p.tint;
   p.rotation=base.rotation+head.rotation-originalHead.rotation;p.scale=base.scale*ratio*(p.id.startsWith('eye-')?eyeScale:p.id==='nose'?noseScale:1);p.flip=base.flip;
   p.path=path;Object.assign(p,dimensions[path]);let localX=0,localY=0;
   if(p.id.startsWith('eye-')){localX=p.id.endsWith('left')?-eyeSpread:eyeSpread;localY=eyeHeight}
   if(p.id.startsWith('brow-')){localX=p.id.endsWith('left')?-eyeSpread:eyeSpread;localY=eyeHeight+browHeight;p.rotation+=p.id.endsWith('left')?browAngle:-browAngle}
   if(p.id==='nose'){localX=noseX;localY=noseY}
   const xx=dx+localX*ratio,yy=dy+localY*ratio;
   p.x=hc.x+xx*Math.cos(a)-yy*Math.sin(a)-p.width*p.scale*p.pivotX;p.y=hc.y+xx*Math.sin(a)+yy*Math.cos(a)-p.height*p.scale*p.pivotY;
 }
}

function positionMan5(){const hair=byId('hair');if(!/Man5\.png$/i.test(hair.path))return;const head=byId('head'),base=approvedLayout.find(p=>p.id==='head'),ratio=head.scale/base.scale;hair.x=head.x+(222.5-base.x)*ratio;hair.y=head.y+(111.05-base.y)*ratio;}
function positionMan2(){const hair=byId('hair');if(!/Man2\.png$/i.test(hair.path))return;const head=byId('head'),base=approvedLayout.find(p=>p.id==='head'),ratio=head.scale/base.scale;hair.x=head.x+(223.5-base.x)*ratio;hair.y=head.y+(102.05-base.y)*ratio;}

function varyIdentity(){const tint=pick(categoryGroups('Skin'));for(const p of parts.filter(p=>p.path.startsWith('PNG/Skin/'))){const role=p.path.match(/_(\w+)\.png$/)[1];replaceAsset(p,paths.find(path=>path.startsWith('PNG/Skin/'+tint+'/')&&path.endsWith('_'+role+'.png')))}
 const p=byId('hair'),path=pick(paths.filter(path=>path.startsWith('PNG/Hair/'))),base=approvedLayout.find(p=>p.id==='hair'),head=byId('head'),headBase=approvedLayout.find(p=>p.id==='head');
 // Hair lengths differ dramatically: align the top edge rather than the image center.
 delete p.tint;p.path=path;Object.assign(p,dimensions[path]);p.scale=base.scale*head.scale/headBase.scale;p.x=head.x+(base.x+base.width/2-headBase.x)*head.scale/headBase.scale-p.width*p.scale/2;p.y=head.y+(base.y-headBase.y)*head.scale/headBase.scale;positionMan2();positionMan5();
}
$('randomFace').onclick=()=>{record();varyFace();render();$('status').textContent='Kaş, göz ve burun konumları ölçülü olarak çeşitlendirildi.'};
$('randomClothes').onclick=()=>{record();varyClothes();render();$('status').textContent='Kıyafet renkleri değiştirildi; poz aynı kaldı.'};
$('newCharacter').onclick=()=>{record();varyIdentity();applyHairColor(pick(hairPalette).value);varyFace();varyClothes();render();$('status').textContent='Aynı pozda yeni karakter hazır.'};

setupHairColors();
fresh();try{const saved=localStorage.getItem('kenney-layout-editor-approved-v4-colors');if(saved)parts=validate(JSON.parse(saved))}catch{}try{if(!localStorage.getItem('man2-position-v1')){positionMan2();localStorage.setItem('man2-position-v1','1')}}catch{positionMan2()}try{if(!localStorage.getItem('man5-position-v1')){positionMan5();localStorage.setItem('man5-position-v1','1')}}catch{positionMan5()}selected=['arm-right','sleeve-right','hand-right'];render();document.getElementById("status").textContent='Gönderdiğin yerleşim hazır. Yüzü ve kıyafet renklerini değiştirebilirsin.';
</script></body></html>


